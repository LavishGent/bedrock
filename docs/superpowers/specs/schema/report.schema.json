{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bedrock.invalid/poc/0.2/report.schema.json",
  "title": "Bedrock POC check report",
  "description": "Output of `bedrock check --format json`. Verdict: any violation gives VIOLATION/1; otherwise any diagnostic with relevance=indeterminate gives INDETERMINATE/2; otherwise PASS/0. Every diagnostic is listed in every case. Rules: README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "tool",
    "status",
    "exit_code",
    "build_profile",
    "policy",
    "inputs",
    "assumptions",
    "summary",
    "packages",
    "rules",
    "violations",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "report"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "bedrock"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "VIOLATION",
        "INDETERMINATE"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "build_profile": {
      "$ref": "common.schema.json#/$defs/buildProfile"
    },
    "policy": {
      "description": "sha256 is null when the policy file is missing (which is itself a global policy_missing diagnostic).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          ]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "shard_count"
      ],
      "properties": {
        "manifest_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          ]
        },
        "shard_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assumptions": {
      "description": "Analysis assumptions the verdict depends on, with how many diagnostics each one exempted. Sorted by id. Plan section 7 (owner decision A) requires trusted_stdlib to be listed whenever restrict_concept_to_boundary is evaluated.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "exempted_count"
        ],
        "properties": {
          "id": {
            "enum": [
              "trusted_stdlib",
              "no_possible_target"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "exempted_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "violations",
        "indeterminate_diagnostics",
        "warning_diagnostics",
        "units_analyzed",
        "rules"
      ],
      "properties": {
        "violations": {
          "type": "integer",
          "minimum": 0
        },
        "indeterminate_diagnostics": {
          "type": "integer",
          "minimum": 0
        },
        "warning_diagnostics": {
          "type": "integer",
          "minimum": 0
        },
        "units_analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "rules": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "packages": {
      "description": "Plan section 7: the report lists included and excluded packages and files.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "excluded_files"
      ],
      "properties": {
        "included": {
          "description": "Module units analyzed. Sorted, unique.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/unitId"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "build_constraint",
                  "test_only",
                  "outside_module",
                  "load_error"
                ]
              }
            }
          }
        },
        "excluded_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "$ref": "common.schema.json#/$defs/relPath"
              },
              "reason": {
                "enum": [
                  "build_constraint",
                  "test_file",
                  "cgo_disabled",
                  "ignored_by_go"
                ]
              }
            }
          }
        }
      }
    },
    "rules": {
      "description": "One entry per policy rule. Sorted by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleResult"
      }
    },
    "violations": {
      "description": "Sorted by (rule_id, location.file, location.line, location.column, id); null locations sort first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    },
    "diagnostics": {
      "description": "Every diagnostic from the manifest and all shards, plus evaluator diagnostics. Sorted by (relevance: indeterminate first, then warning), then id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/reportDiagnostic"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "violations": {
            "maxItems": 0
          },
          "summary": {
            "properties": {
              "violations": {
                "const": 0
              },
              "indeterminate_diagnostics": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "VIOLATION"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 1
          },
          "violations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "INDETERMINATE"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 2
          },
          "violations": {
            "maxItems": 0
          },
          "summary": {
            "properties": {
              "violations": {
                "const": 0
              },
              "indeterminate_diagnostics": {
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ruleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "violation_ids",
        "diagnostic_ids"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ruleId"
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/ruleKind"
        },
        "status": {
          "enum": [
            "PASS",
            "VIOLATION",
            "INDETERMINATE"
          ]
        },
        "violation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/violationId"
          }
        },
        "diagnostic_ids": {
          "description": "Diagnostics with relevance=indeterminate for this rule. Sorted, unique.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/diagnosticId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "VIOLATION"
              }
            }
          },
          "then": {
            "properties": {
              "violation_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INDETERMINATE"
              }
            }
          },
          "then": {
            "properties": {
              "violation_ids": {
                "maxItems": 0
              },
              "diagnostic_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "violation_ids": {
                "maxItems": 0
              },
              "diagnostic_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "rule_kind",
        "location",
        "message",
        "evidence_chain",
        "remediation"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/violationId"
        },
        "rule_id": {
          "$ref": "common.schema.json#/$defs/ruleId"
        },
        "rule_kind": {
          "$ref": "common.schema.json#/$defs/ruleKind"
        },
        "location": {
          "$ref": "common.schema.json#/$defs/nullableLocation"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence_chain": {
          "description": "Ordered witness from an Entry (or the importing unit) to the offending fact.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "from",
              "to",
              "loc"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "entry",
                  "route",
                  "call",
                  "import",
                  "middleware_missing",
                  "concept_binding"
                ]
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/nullableLocation"
              }
            }
          }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message",
            "suggest"
          ],
          "properties": {
            "message": {
              "type": "string"
            },
            "suggest": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "reportDiagnostic": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/diagnosticCore"
        }
      ],
      "type": "object",
      "required": [
        "relevance",
        "affects_rules"
      ],
      "properties": {
        "relevance": {
          "description": "indeterminate: affects at least one rule and counts toward verdict 2. warning: affects no rule.",
          "enum": [
            "indeterminate",
            "warning"
          ]
        },
        "affects_rules": {
          "description": "Rules this diagnostic makes indeterminate, with the reason. Sorted by rule_id, unique rule_id. Empty iff relevance=warning.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "reason"
            ],
            "properties": {
              "rule_id": {
                "$ref": "common.schema.json#/$defs/ruleId"
              },
              "reason": {
                "enum": [
                  "global_failure",
                  "policy_config",
                  "unit_in_scope",
                  "reachable_from_governed_entry",
                  "route_registration",
                  "middleware_chain"
                ]
              }
            }
          }
        }
      },
      "unevaluatedProperties": false,
      "if": {
        "properties": {
          "relevance": {
            "const": "warning"
          }
        }
      },
      "then": {
        "properties": {
          "affects_rules": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "affects_rules": {
            "minItems": 1
          }
        }
      }
    }
  }
}
